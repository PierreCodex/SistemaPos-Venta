# Plantilla del .env de PRODUCCIÓN — copiar como .env EN EL SERVIDOR y completar.
# NUNCA subir el .env real al repo. Lo crítico vs desarrollo:

APP_NAME="SistemaPos"
APP_ENV=production          # ← NO "local"
APP_KEY=                    # php artisan key:generate (una sola vez en el server)
APP_DEBUG=false             # ← CRÍTICO: true expone stack traces con secretos
APP_URL=https://tudominio.com

LOG_CHANNEL=daily
LOG_LEVEL=error             # ← NO "debug"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true  # solo cookies por HTTPS
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
# ... credenciales de correo de producción
