# Red de seguridad para hostings que apuntan el dominio a la RAÍZ del proyecto
# (lo correcto es apuntar a public/, pero si no se puede, esto reescribe todo
# hacia public/ y evita que archivos del proyecto — .env, scripts, vendor/ —
# sean accesibles por URL).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Lo que ya apunta a public/ pasa tal cual (evita public/public/...)
    RewriteRule ^public/ - [L]
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Nunca servir dotfiles (.env, .git) directamente
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
